<article class="showcase-item">
  <header class="showcase-head"></header>

  <div class="showcase-grid">
    <div class="showcase-media">
      {% if include.item.embed %}
        {% assign source = 'https://www.youtube.com/embed/' | append: include.item.embed.id %}
        {% if include.item.embed.hideRel %}
          {% assign source = source | append: '?rel=0' %}
        {% endif %}
        <div class="ratio-16x9">
          <iframe
            width="560"
            height="315"
            src="{{ source }}"
            title="{{ include.item.title | escape }}"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          >
          </iframe>
        </div>
      {% endif %}
    </div>

    <div class="showcase-body">
      <h3 class="showcase-title">{{ include.item.title }}</h3>
      <p class="showcase-description">{{ include.item.description }}</p>

      <div class="showcase-item-links">
        {% if include.item.project %}
          {% assign project = include.item.project | to_s | strip %}
          {% assign matchedProject = site.projects | where: 'slug', project | first %}
          {% if matchedProject %}
            <span>Project: </span>
            <a href="{{ matchedProject.url | relative_url }}">{{ matchedProject.title }}</a>
          {% endif %}
        {% endif %}

        <br>

        {% if include.item.writeup %}
          {% assign writeup = include.item.writeup %}
          {% assign matchedWriteup = site.writeups | where: 'slug', writeup | first %}
          {% if matchedWriteup %}
            <span>Writeup: </span>
            <a href="{{ matchedWriteup.id }}">{{ matchedWriteup.title }}</a>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
</article>
