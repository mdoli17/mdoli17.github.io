{% comment %}
  Usage: {% include project_writeups.liquid project_slug=page.slug %}
  Each post must have: project: slug
{% endcomment %}

{% assign writeups = site.writeups | where: 'project', page.slug %}

{% if writeups.size > 0 %}
  <div class="post">
    <ul class="post-list">
      {% for writeup in writeups %}
        {% assign read_time = writeup.content | number_of_words | divided_by: 180 | plus: 1 %}

        <li>
          {% if writeup.thumbnail %}
            <div class="row">
              <div class="col-sm-9">
          {% endif %}

          <h3>
            <a class="post-title" href="{{ writeup.id | relative_url }}">{{ writeup.title }}</a>
          </h3>

          <p>{{ writeup.description }}</p>
          <p class="post-meta">{{ read_time }} min read</p>

          {% if writeup.thumbnail %}
            </div>
            <div class="col-sm-3">
              <img class="card-img" src="{{ writeup.thumbnail | relative_url }}" style="object-fit: cover; height: 90%" alt="image">
            </div>
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
{% endif %}
